# ── E2E Test Environment Variables ────────────────────────────────────────────
# Copy to .env.test and fill in real values for local test runs.
# In CI, these are set as GitHub Actions secrets.
#
# NEVER commit .env.test — it is covered by .env* in .gitignore.

# ── Supabase (same project as the app) ───────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Browserless (optional for local, required in CI) ─────────────────────────
# BROWSERLESS_API_KEY=your-browserless-token

# ── Test target URL ──────────────────────────────────────────────────────────
# TEST_BASE_URL=https://interact-portal.vercel.app

# ── Dedicated E2E test accounts ──────────────────────────────────────────────
# These are test-only accounts, NOT personal or production credentials.
# Create them via Supabase admin API or dashboard.

# Admin test account (role: admin)
E2E_ADMIN_EMAIL=e2e-admin@interactenglish.de
E2E_ADMIN_PASS=

# Teaching Artist A — primary test TA
E2E_TA_A_EMAIL=e2e-ta-a@interactenglish.de
E2E_TA_A_PASS=

# Teaching Artist B — secondary TA for cross-account isolation tests
E2E_TA_B_EMAIL=e2e-ta-b@interactenglish.de
E2E_TA_B_PASS=

# School project token (UUID) for school portal tests
E2E_SCHOOL_PROJECT_TOKEN=
